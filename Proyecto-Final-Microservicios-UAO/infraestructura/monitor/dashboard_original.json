{"uid": "reservas", "title": "Reservas universitarias", "schemaVersion": 39, "refresh": "5s", "time": {"from": "now-15m", "to": "now"}, "panels": [{"id": 1, "type": "timeseries", "title": "Réplicas que responden", "datasource": {"type": "prometheus", "uid": "prom"}, "targets": [{"expr": "sum(up) by (job)", "legendFormat": "{{job}}", "refId": "A"}], "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}}, {"id": 2, "type": "timeseries", "title": "Solicitudes por segundo", "datasource": {"type": "prometheus", "uid": "prom"}, "targets": [{"expr": "sum(rate(reservas_http_total[1m])) by (servicio)", "legendFormat": "{{servicio}}", "refId": "A"}], "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}}, {"id": 3, "type": "timeseries", "title": "Respuestas con error por minuto", "datasource": {"type": "prometheus", "uid": "prom"}, "targets": [{"expr": "sum(increase(reservas_http_total{estado=~\"[45]..\"}[1m])) by (servicio,estado)", "legendFormat": "{{servicio}} {{estado}}", "refId": "A"}], "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}}, {"id": 4, "type": "timeseries", "title": "Latencia p95 en segundos", "datasource": {"type": "prometheus", "uid": "prom"}, "targets": [{"expr": "histogram_quantile(0.95,sum(rate(reservas_duracion_segundos_bucket[1m])) by (le,servicio))", "legendFormat": "{{servicio}}", "refId": "A"}], "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}}]}